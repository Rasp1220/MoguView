# YouTube Data API v3 key（サーバー専用）。取り込みバッチ
# `/api/cron/fetch-videos` だけが使う。サイト側のリクエストでは呼ばない。
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Supabase（Project Settings -> API）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 取り込みバッチの書き込み用。絶対に公開しないこと。
SUPABASE_SERVICE_ROLE_KEY=

# `/api/cron/fetch-videos` を呼ぶときの認証トークン
# （`Authorization: Bearer <この値>`）。例: `openssl rand -hex 32`
CRON_SECRET=

# （任意）取り込む動画数の上限。既定 50000。
MAX_VIDEOS=50000
